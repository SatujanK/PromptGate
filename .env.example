# Copy this file to .env and replace the fake values with your real keys.
# .env is in .gitignore, so your real keys never leave this machine.
# A key already set as a Windows environment variable takes priority over this file.

# From https://console.anthropic.com -> API Keys
ANTHROPIC_API_KEY=sk-ant-fake-key-replace-me

# From https://console.typesafe.ai
TYPESAFE_API_KEY=ts-fake-key-replace-me
